// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// Keep the developer-specific Apple Team ID outside version control. Copy
// Signing.local.xcconfig.example to Signing.local.xcconfig before a signed
// macOS build that uses the Data Protection Keychain.
#include? "Signing.local.xcconfig"
DEVELOPMENT_TEAM = $(HALO_DEVELOPMENT_TEAM)
CODE_SIGN_IDENTITY[sdk=macosx*] = $(HALO_CODE_SIGN_IDENTITY)

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = halo_demo

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = org.halo.haloDemo

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 org.halo. All rights reserved.

// The current macOS demo and Rust framework intentionally target Apple
// Silicon only. Intel support requires an explicit compatibility decision.
ARCHS = arm64
ONLY_ACTIVE_ARCH = YES
